generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  TERMINATED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
  BREAK_START
  BREAK_END
}

enum AttendanceComplaintType {
  CHECK_IN
  CHECK_OUT
  BOTH
  STATUS
  OTHER
}

enum AttendanceComplaintStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceRequestAction {
  INSERT
  EDIT
}

enum AttendanceLegacyStatus {
  Present
  Absent
  Late
  Leave

  @@map("attendance_old_status")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveAction {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveRequestType {
  ANNUAL
  CASUAL
  SICK
  UNPAID
  OTHER
}

model Role {
  id       Int    @id @default(autoincrement()) @db.UnsignedInt
  roleName String @unique @map("role_name") @db.VarChar(50)

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id             Int    @id @default(autoincrement()) @db.UnsignedInt
  permissionName String @unique @map("permission_name") @db.VarChar(100)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id") @db.UnsignedInt
  permissionId Int @map("permission_id") @db.UnsignedInt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Designation {
  id              Int    @id @default(autoincrement()) @db.UnsignedInt
  designationName String @map("designation_name") @db.VarChar(100)

  departmentId Int @map("departmentId") @db.UnsignedInt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  users User[]

  attendanceRecords Attendance[]

  attendanceSummaries AttendanceSummary[]

  @@unique([departmentId, designationName], map: "designations_departmentId_designation_name_key")
  @@index([departmentId])
  @@map("designations")
}

model User {
  id Int @id @default(autoincrement()) @db.UnsignedInt

  userCode String? @unique @map("userCode") @db.VarChar(20)
  biometricId String? @unique(map: "biometric_id") @map("biometric_id") @db.VarChar(50)
  firstName String @map("firstName") @db.VarChar(100)
  lastName String @map("lastName") @db.VarChar(100)

  email String @unique @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)

  phone String? @db.VarChar(20)
  address String? @db.VarChar(255)
  photo String? @db.VarChar(255)

  designationId Int? @map("designation_id") @db.UnsignedInt
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  joiningDate DateTime? @map("joiningDate") @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE)
  status UserStatus? @default(ACTIVE)

  roleId Int @map("role_id") @db.UnsignedInt
  role Role @relation(fields: [roleId], references: [id])

  departmentId Int? @map("department_id") @db.UnsignedInt
  department Department? @relation(fields: [departmentId], references: [id])

  attendanceRecords Attendance[]
  legacyAttendanceRecords AttendanceLegacy[]
  attendanceSummaries AttendanceSummary[]

  leaveRequests              LeaveRequest[] @relation("LeaveRequester")
  leaveReportingRequests     LeaveRequest[] @relation("LeaveReportingTo")
  leaveBackupRequests        LeaveRequest[] @relation("LeaveBackupEmployee")
  currentLeaveApprovals      LeaveRequest[] @relation("CurrentLeaveApprover")
  leaveApprovals             LeaveApproval[] @relation("LeaveApprovalRefersTo")

  attendanceComplaints AttendanceComplaint[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  passwordResetToken PasswordResetToken?

  @@index([roleId])
  @@index([departmentId])
  @@index([designationId])
  @@index([biometricId])

  @@map("users")
}

model Department {
  id Int @id @default(autoincrement()) @db.UnsignedInt
  departmentName String @unique @map("department_name") @db.VarChar(100)
  description String? @db.VarChar(255)
  users User[]
  designations Designation[]
  attendanceRecords Attendance[]
  attendanceSummaries AttendanceSummary[]

  @@map("departments")
}

model Attendance {
  id Int @id @default(autoincrement()) @db.UnsignedInt

  userId Int @map("user_id") @db.UnsignedInt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attendance_user")
  userCode String @map("user_code") @db.VarChar(50)
  biometricId String @map("biometric_id") @db.VarChar(50)
  fullName String @map("full_name") @db.VarChar(100)
  locationId Int? @map("location_id") @db.UnsignedInt
  departmentId Int? @map("department_id") @db.UnsignedInt
  department Department? @relation(fields: [departmentId], references: [id], onUpdate: NoAction, map: "fk_attendance_department")
  designationId Int? @map("designation_id") @db.UnsignedInt
  designation Designation? @relation(fields: [designationId], references: [id], onUpdate: NoAction, map: "fk_attendance_designation")
  eventType AttendanceEventType @map("event_type")
  eventTime DateTime @map("event_time") @db.DateTime(0)
  remarks String? @db.Text
  sourceKey String? @unique @map("source_key") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  complaints AttendanceComplaint[]

  @@index([userId], map: "idx_user_date")
  @@index([userId, eventType], map: "idx_user_date_event")
  @@index([userId], map: "idx_user_id")
  @@index([biometricId], map: "idx_attendance_biometric_id")
  @@index([eventTime], map: "idx_attendance_event_time")
  @@index([eventType], map: "idx_attendance_event_type")
  @@index([locationId], map: "idx_attendance_location_id")
  @@index([departmentId], map: "idx_department_id")
  @@index([designationId], map: "idx_designation_id")
  @@map("attendance")
}

model AttendanceLegacy {
  id             Int                    @id @default(autoincrement())
  userId         Int?                   @map("user_id") @db.UnsignedInt
  user           User?                  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "attendance_user_id_fkey")
  userCode       String                 @map("user_code") @db.VarChar(50)
  fullName       String                 @map("full_name") @db.VarChar(100)
  role           String                 @db.VarChar(50)
  department     String                 @db.VarChar(100)
  attendanceDate DateTime               @map("attendance_date") @db.Date
  checkIn        DateTime?              @map("check_in") @db.Time(0)
  checkOut       DateTime?              @map("check_out") @db.Time(0)
  status         AttendanceLegacyStatus
  remarks        String?                @db.Text
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @map("updated_at")
  sourceKey      String?                @unique(map: "attendance_source_key_key") @map("source_key") @db.VarChar(128)

  @@index([userId, attendanceDate], map: "attendance_user_id_attendance_date_idx")
  @@map("attendance_old")
}

model AttendanceSummary {
  id Int @id @default(autoincrement()) @db.UnsignedInt
  userId Int @map("user_id") @db.UnsignedInt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId Int? @map("department_id") @db.UnsignedInt
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId Int? @map("designation_id") @db.UnsignedInt
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  attendanceDate DateTime @map("attendance_date") @db.Date
  firstCheckIn DateTime? @map("first_check_in")
  lastCheckOut DateTime? @map("last_check_out")
  workingMinutes Int @default(0) @map("working_minutes")
  lateMinutes Int @default(0) @map("late_minutes")
  earlyLeaveMinutes Int @default(0) @map("early_leave_minutes")
  overtimeMinutes Int @default(0) @map("overtime_minutes")
  expectedMinutes Int @map("expected_minutes")
  attendanceStatus AttendanceStatus @map("attendance_status")
  remarks String? @db.Text
  calculatedAt DateTime @default(now()) @map("calculated_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  complaints AttendanceComplaint[]

  @@unique([userId, attendanceDate])
  @@index([userId])
  @@index([attendanceDate])
  @@index([departmentId])
  @@index([designationId])
  @@map("attendance_summary")
}

model AttendanceComplaint {
  id                Int                       @id @default(autoincrement())
  userId            Int                       @map("user_id") @db.UnsignedInt
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyAttendanceId Int?                      @map("daily_attendance_id") @db.UnsignedInt
  dailyAttendance   AttendanceSummary?        @relation(fields: [dailyAttendanceId], references: [id], onDelete: SetNull)
  rawAttendanceId   Int?                      @map("raw_attendance_id") @db.UnsignedInt
  rawAttendance     Attendance?               @relation(fields: [rawAttendanceId], references: [id], onDelete: SetNull)
  attendanceDate    DateTime                  @map("attendance_date") @db.Date
  requestedAttendanceDate DateTime             @map("requested_attendance_date") @db.Date
  requestAction     AttendanceRequestAction   @default(EDIT) @map("request_action")
  requestedEventTime String                   @map("requested_event_time") @db.VarChar(5)
  complaintType     AttendanceComplaintType   @map("complaint_type")
  reason            String                    @db.Text
  status            AttendanceComplaintStatus @default(PENDING)
  reviewNote        String?                   @map("review_note") @db.Text
  reviewedAt        DateTime?                 @map("reviewed_at") @db.DateTime(0)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([userId, attendanceDate])
  @@index([dailyAttendanceId])
  @@index([rawAttendanceId])
  @@index([status])
  @@map("attendance_complaints")
}

model LeaveRequest {
  id                   Int                 @id @default(autoincrement()) @db.UnsignedInt

  userId               Int                 @map("user_id") @db.UnsignedInt
  user                 User                @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)

  type                 LeaveRequestType
  startDate            DateTime            @map("start_date") @db.Date
  endDate              DateTime            @map("end_date") @db.Date
  totalDays            Int                 @map("total_days")
  reason               String?             @db.Text

  status               LeaveRequestStatus  @default(PENDING)

  reportingToId        Int?                @map("reporting_to_id") @db.UnsignedInt
  reportingTo          User?               @relation("LeaveReportingTo", fields: [reportingToId], references: [id], onDelete: Restrict)

  backupEmployeeId     Int?                @map("backup_employee_id") @db.UnsignedInt
  backupEmployee       User?               @relation("LeaveBackupEmployee", fields: [backupEmployeeId], references: [id], onDelete: SetNull)

  currentApprovalLevel Int                 @default(1) @map("current_approval_level")
  currentRefersTo      Int?                @map("current_refers_to") @db.UnsignedInt

  currentApprover      User?               @relation("CurrentLeaveApprover", fields: [currentRefersTo], references: [id], onDelete: SetNull)

  approvals            LeaveApproval[]

  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([userId])
  @@index([reportingToId])
  @@index([backupEmployeeId])
  @@index([currentRefersTo])
  @@index([status])

  @@map("leave_requests")
}


model LeaveApproval {
  id             Int                 @id @default(autoincrement()) @db.UnsignedInt

  leaveRequestId Int                 @map("leave_request_id") @db.UnsignedInt
  leaveRequest   LeaveRequest        @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  refersTo       Int                 @map("refers_to") @db.UnsignedInt
  approver       User                @relation("LeaveApprovalRefersTo",fields: [refersTo],references: [id],onDelete: Cascade)

  approvalLevel  Int                 @map("approval_level")

  status         LeaveApprovalStatus @default(PENDING)

  action         LeaveAction         @default(SUBMITTED)

  decisionNote   String?             @map("decision_note") @db.Text

  decidedAt      DateTime?            @map("decided_at") @db.DateTime(0)

  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([leaveRequestId])
  @@index([refersTo])
  @@index([status])
  @@index([action])

  @@map("leave_approvals")
}


model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  userId Int @unique @map("user_id") @db.UnsignedInt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("password_reset_tokens")
}
