generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  TERMINATED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
  BREAK_START
  BREAK_END
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveAction {
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveRequestType {
  ANNUAL
  CASUAL
  SICK
  UNPAID
  OTHER
}

model Role {
  id       Int    @id @default(autoincrement()) @db.UnsignedInt
  roleName String @unique @map("role_name") @db.VarChar(50)

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id             Int    @id @default(autoincrement()) @db.UnsignedInt
  permissionName String @unique @map("permission_name") @db.VarChar(100)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id") @db.UnsignedInt
  permissionId Int @map("permission_id") @db.UnsignedInt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Designation {
  id              Int    @id @default(autoincrement()) @db.UnsignedInt
  designationName String @map("designation_name") @db.VarChar(100)

  departmentId Int @map("department_id") @db.UnsignedInt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  users User[]

  attendanceRecords Attendance[]

  attendanceSummaries AttendanceSummary[]

  @@unique([departmentId, designationName])
  @@index([departmentId])
  @@map("designations")
}

model User {
  id Int @id @default(autoincrement()) @db.UnsignedInt

  userCode String? @unique @map("userCode") @db.VarChar(20)

  firstName String @map("firstName") @db.VarChar(100)
  lastName  String @map("lastName") @db.VarChar(100)

  email        String @unique @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)

  phone   String? @db.VarChar(20)
  address String? @db.VarChar(255)
  photo   String? @db.VarChar(255)

  designationId Int? @map("designation_id") @db.UnsignedInt

  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  joiningDate DateTime? @map("joiningDate") @db.Date

  employmentStatus EmploymentStatus @default(ACTIVE)
  status UserStatus? @default(ACTIVE)

  roleId Int @map("role_id") @db.UnsignedInt
  role Role @relation(fields: [roleId], references: [id])

  departmentId Int? @map("department_id") @db.UnsignedInt

  department Department? @relation(fields: [departmentId], references: [id])

  attendanceRecords Attendance[]

  attendanceSummaries AttendanceSummary[]

  leaveRequests LeaveRequest[] @relation("LeaveRequester")

  currentLeaveApprovals LeaveRequest[] @relation("CurrentLeaveApprover")

  leaveApprovals LeaveApproval[] @relation("LeaveApprovalRefersTo")

  leaveApprovalHistory LeaveApprovalHistory[] @relation("LeaveHistoryRefersTo")

  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([roleId])
  @@index([departmentId])

  @@map("users")
}

model Department {

  id Int @id @default(autoincrement()) @db.UnsignedInt

  departmentName String @unique @map("department_name") @db.VarChar(100)

  description String? @db.VarChar(255)

  users User[]

  designations Designation[]

  attendanceRecords Attendance[]

  attendanceSummaries AttendanceSummary[]

  @@map("departments")
}

model Attendance {

  id Int @id @default(autoincrement()) @db.UnsignedInt

  userId Int @map("user_id") @db.UnsignedInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  userCode String @map("user_code") @db.VarChar(50)

  fullName String @map("full_name") @db.VarChar(100)

  departmentId Int? @map("department_id") @db.UnsignedInt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  designationId Int? @map("designation_id") @db.UnsignedInt

  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  attendanceDate DateTime @map("attendance_date") @db.Date

  eventType AttendanceEventType @map("event_type")

  eventTime DateTime @map("event_time")

  remarks String? @db.Text

  sourceKey String? @unique @map("source_key") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  @@index([userId])

  @@index([attendanceDate])

  @@index([departmentId])

  @@index([designationId])

  @@map("attendance")
}

model AttendanceSummary {

  id Int @id @default(autoincrement()) @db.UnsignedInt

  userId Int @map("user_id") @db.UnsignedInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId Int? @map("department_id") @db.UnsignedInt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  designationId Int? @map("designation_id") @db.UnsignedInt

  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  attendanceDate DateTime @map("attendance_date") @db.Date

  firstCheckIn DateTime? @map("first_check_in")

  lastCheckOut DateTime? @map("last_check_out")

  workingMinutes Int @default(0) @map("working_minutes")

  lateMinutes Int @default(0) @map("late_minutes")

  earlyLeaveMinutes Int @default(0) @map("early_leave_minutes")

  overtimeMinutes Int @default(0) @map("overtime_minutes")

  expectedMinutes Int @map("expected_minutes")

  attendanceStatus AttendanceStatus @map("attendance_status")

  remarks String? @db.Text

  calculatedAt DateTime @default(now()) @map("calculated_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, attendanceDate])

  @@index([userId])

  @@index([attendanceDate])

  @@index([departmentId])

  @@index([designationId])

  @@map("attendance_summary")
}

model LeaveRequest {
  id                   Int                    @id @default(autoincrement()) @db.UnsignedInt
  userId               Int                    @map("user_id") @db.UnsignedInt
  user                 User                   @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  type                 LeaveRequestType
  startDate            DateTime               @map("start_date") @db.Date
  endDate              DateTime               @map("end_date") @db.Date
  totalDays            Int                    @map("total_days")
  reason               String?                @db.Text
  status               LeaveRequestStatus     @default(PENDING)
  currentApprovalLevel Int                    @default(1) @map("current_approval_level")
  currentRefersTo      Int?                   @map("current_refers_to") @db.UnsignedInt
  currentApprover      User?                  @relation("CurrentLeaveApprover", fields: [currentRefersTo], references: [id], onDelete: SetNull)
  approvals            LeaveApproval[]
  history              LeaveApprovalHistory[]
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([userId])
  @@index([currentRefersTo])
  @@index([status])
  @@map("leave_requests")
}

model LeaveApproval {
  id             Int                 @id @default(autoincrement()) @db.UnsignedInt
  leaveRequestId Int                 @map("leave_request_id") @db.UnsignedInt
  leaveRequest   LeaveRequest        @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  refersTo       Int                 @map("refers_to") @db.UnsignedInt
  approver       User                @relation("LeaveApprovalRefersTo", fields: [refersTo], references: [id], onDelete: Cascade)
  approvalLevel  Int                 @map("approval_level")
  status         LeaveApprovalStatus @default(PENDING)
  decisionNote   String?             @map("decision_note") @db.Text
  decidedAt      DateTime?           @map("decided_at") @db.DateTime(0)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([leaveRequestId])
  @@index([refersTo])
  @@index([status])
  @@map("leave_approvals")
}

model LeaveApprovalHistory {
  id             Int          @id @default(autoincrement()) @db.UnsignedInt
  leaveRequestId Int          @map("leave_request_id") @db.UnsignedInt
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  refersTo       Int          @map("refers_to") @db.UnsignedInt
  user           User         @relation("LeaveHistoryRefersTo", fields: [refersTo], references: [id], onDelete: Cascade)
  approvalLevel  Int          @map("approval_level")
  action         LeaveAction
  remarks        String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([leaveRequestId])
  @@index([refersTo])
  @@map("leave_approval_history")
}

model PasswordResetToken {
  id Int @id @default(autoincrement()) @db.UnsignedInt

  userId Int @map("user_id") @db.UnsignedInt
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique @map("token_hash") @db.VarChar(255)

  expiresAt DateTime @map("expires_at") @db.Timestamp(0)
  usedAt    DateTime? @map("used_at") @db.Timestamp(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
